# Copy to app/.env and fill in. app/.env is gitignored and must never be committed.
#
# The app holds ZERO provider credentials. Google Cloud Vision and the VLM are called only from the
# server, which reads their keys from server/.env. Anything in this file is compiled into the APK and
# extractable with `strings` - treat it accordingly.
#
# Expo inlines variables prefixed with EXPO_PUBLIC_ at build time. That prefix is a statement of fact
# about where these values end up, not a mistake.

# Base URL of the benchmark server, including scheme, no trailing slash.
# Local development against a device on the same network: http://192.168.1.10:3002
EXPO_PUBLIC_SERVER_URL=https://scanner.yo-po.eu

# Shared bearer token sent on every request except /health. Must match API_BEARER_TOKEN in
# server/.env. It is bundled into the APK and therefore not a secret: it is a coarse gate on a
# personal benchmark server, it is rotatable, and it is used nowhere else.
EXPO_PUBLIC_API_TOKEN=
