# Dependencies
node_modules/
.pnpm-store/

# husky's generated shim directory — the hooks themselves are committed
.husky/_/

# Build output
dist/
build/
*.tsbuildinfo

# Environment — never commit real credentials, only .env.example
.env
.env.*
!.env.example

# Provider key files, mounted into the server container read-only — deploy/README.md. A Google
# service-account JSON is a private key in a file that looks like configuration; gitleaks would
# catch it at the hook, and this makes sure it never gets that far.
deploy/secrets/

# Expo / React Native
app/.expo/
# Generated by `expo prebuild` from app.json and the config plugins - ADR-19. Regenerating it is a
# command, committing it is a second source of truth that drifts from app.json.
app/android/
app/ios/
app/expo-env.d.ts
app/.kotlin/
*.apk
*.aab
*.keystore
!debug.keystore

# Server runtime data — the image store and SQLite database are local state
server/data/
server/images/
*.sqlite
*.sqlite-journal
*.db

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Editors
.idea/
.vscode/
*.swp

# OS
.DS_Store
Thumbs.db
