# Copy to server/.env and fill in. server/.env is gitignored and must never be committed.
#
# This is where every provider credential lives. The app has none of them, on purpose - the
# repository is public and keys compiled into an APK are extractable with `strings`.
#
# Variables are listed in the phase that introduces them. Ones marked "phase NN" are read by code
# that does not exist yet; they are here so the full surface is visible in one place.

# --- Server (phase 02) ---------------------------------------------------------------------------

NODE_ENV=development
LOG_LEVEL=info

# Bound to loopback in production; nginx terminates TLS and proxies to it. Ports 3002 and 3003 are
# the free ones on the deployment box - see docs/deployment-target.md.
HOST=127.0.0.1
PORT=3002

# Shared bearer token required on everything except /health. Must match EXPO_PUBLIC_API_TOKEN in
# app/.env. Generate with: openssl rand -hex 32
API_BEARER_TOKEN=

# Where uploaded images are written. The OCR sidecar mounts this same directory read-only.
# The server constructs every path from the image ID; a path never arrives from a client.
IMAGE_DIR=./data/images

# SQLite database file (better-sqlite3 + Drizzle).
DATABASE_PATH=./data/scanner.sqlite

# --- Self-hosted OCR sidecar (phase 07) ----------------------------------------------------------

# Reachable only on the internal Docker network; the sidecar publishes no ports.
OCR_SIDECAR_URL=http://ocr:9003

# Explicit timeout on the control channel. No file-drop-and-poll: a request either answers or fails.
OCR_SIDECAR_TIMEOUT_MS=30000

# Path to the image directory as the SIDECAR sees it, when it accepts a path instead of an upload.
OCR_SIDECAR_IMAGE_DIR=/images

# --- Google Cloud Vision (phase 08) --------------------------------------------------------------

# Path to the service-account JSON key file, mounted into the container. The file itself is never
# committed - only its path appears here.
GOOGLE_APPLICATION_CREDENTIALS=./secrets/gcv-service-account.json

# --- VLM (phase 09) ------------------------------------------------------------------------------

# Selects the VlmProvider implementation. Swapping providers means adding one file and changing this.
VLM_PROVIDER=openai

OPENAI_API_KEY=
# Part of the `engine` string and therefore of the price-table key, so a model change is visible in
# every stored attempt - ADR-11.
OPENAI_MODEL=
