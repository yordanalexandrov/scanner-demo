# Copy to server/.env and fill in. server/.env is gitignored and must never be committed.
#
# This is where every provider credential lives. The app has none of them, on purpose - the
# repository is public and keys compiled into an APK are extractable with `strings`.
#
# Variables are listed in the phase that introduces them. Ones marked "phase NN" are read by code
# that does not exist yet; they are here so the full surface is visible in one place.

# --- Server (phase 02) ---------------------------------------------------------------------------

NODE_ENV=development
LOG_LEVEL=info

# Bound to loopback in production; nginx terminates TLS and proxies to it. Ports 3002 and 3003 are
# the free ones on the deployment box - see docs/deployment-target.md.
HOST=127.0.0.1
PORT=3002

# Shared bearer token required on everything except /health. Must match EXPO_PUBLIC_API_TOKEN in
# app/.env. Generate with: openssl rand -hex 32
API_BEARER_TOKEN=

# Where uploaded images are written. The OCR sidecar mounts this same directory read-only.
# The server constructs every path from the image ID; a path never arrives from a client.
# Under Compose these three are set to /data/* and each is its own named volume.
IMAGE_DIR=./data/images

# Server-generated thumbnails, cached on disk after the first request. Derived artefacts: deleting
# this directory costs one regeneration, never a dataset.
THUMB_DIR=./data/thumbs

# SQLite database file (better-sqlite3 + Drizzle).
DATABASE_PATH=./data/scanner.sqlite

# Largest accepted upload, in bytes. Must stay <= client_max_body_size on the upload route in
# deploy/nginx/scanner.yo-po.eu.conf, or nginx answers 413 before the request ever reaches here.
MAX_UPLOAD_BYTES=33554432

# --- Self-hosted OCR sidecar (phase 07) ----------------------------------------------------------

# Reachable only on the internal Docker network; the sidecar publishes no ports. Port 9005 is the
# one the image's own server binds - it is never exposed to the host, so it collides with nothing.
OCR_SIDECAR_URL=http://ocr:9005

# Explicit timeout on the control channel. No file-drop-and-poll: a request either answers or fails.
# Generous against a 1.85 s warm median because the box is shared with production - ADR-18.
#
# Keep it BELOW the app's own 45 s round-trip timeout (app/src/api/ocr.ts). The server timing out
# first is what makes a slow engine arrive on the phone as "the engine was too slow" rather than as
# "the request failed" - one of those is a measurement and the other is noise.
OCR_SIDECAR_TIMEOUT_MS=30000

# One dummy inference at startup, so the first real request is not a model load. The cold figure it
# removes is 3.4-3.9 s against a 1.85 s warm median - docs/spikes/07-ocr-sidecar.md.
OCR_WARMUP=true

# There is no OCR_SIDECAR_IMAGE_DIR. The stage A spike established that the engine accepts an HTTP
# upload or base64 and has no path parameter at all, so the server reads the bytes and posts them.
# The image volume is still mounted into the sidecar read-only - see docker-compose.yml for why -
# but nothing can ask the engine to open a file from it.

# --- Google Cloud Vision (phase 08) --------------------------------------------------------------

# Path to the service-account JSON key file, mounted into the container. The file itself is never
# committed - only its path appears here.
GOOGLE_APPLICATION_CREDENTIALS=./secrets/gcv-service-account.json

# --- VLM (phase 09) ------------------------------------------------------------------------------

# Selects the VlmProvider implementation. Swapping providers means adding one file and changing this.
VLM_PROVIDER=openai

OPENAI_API_KEY=
# Part of the `engine` string and therefore of the price-table key, so a model change is visible in
# every stored attempt - ADR-11.
OPENAI_MODEL=
